# Quelle fuer requirements.lock.txt (pip-compile --generate-hashes requirements.in).
# python-json-logger direkt hier gepinnt, weil masterbrain-common als Wheel
# mit --no-deps installiert wird - seine JSON-Logging-Laufzeit-Abhaengigkeit
# muss deshalb ueber diesen Hash-Lock aufgeloest werden, nicht ueber das
# Wheel (siehe auth-gateway/requirements.in fuer dasselbe Muster). PyJWT wird
# NICHT benoetigt: python-nlp-service nutzt bewusst kein
# masterbrain_common.jwt_verify (Trust-Modell unveraendert, nur internes
# Docker-Netz, siehe docs/28_intune_inventory.md-Nachbar-Entscheidung in
# Phase 2B - kein JWT-Pflicht-Zwang).
flask==3.1.3
werkzeug==3.1.8
gunicorn==26.2.0

