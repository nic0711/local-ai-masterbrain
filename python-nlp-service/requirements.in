# Quelle fuer requirements.lock.txt (pip-compile --generate-hashes requirements.in).
# python-json-logger direkt hier gepinnt, weil masterbrain-common als Wheel
# mit --no-deps installiert wird - seine JSON-Logging-Laufzeit-Abhaengigkeit
# muss deshalb ueber diesen Hash-Lock aufgeloest werden, nicht ueber das
# Wheel (siehe auth-gateway/requirements.in fuer dasselbe Muster). PyJWT wird
# NICHT benoetigt: python-nlp-service nutzt bewusst kein
# masterbrain_common.jwt_verify (Trust-Modell unveraendert, nur internes
# Docker-Netz, siehe docs/28_intune_inventory.md-Nachbar-Entscheidung in
# Phase 2B - kein JWT-Pflicht-Zwang).
flask==3.1.3
werkzeug==3.1.8
gunicorn==26.0.0

# spacy 3.8.x ist kompatibel mit NumPy 2.x
# Bewusst auf 3.8.13 gepinnt (nicht neuer): weder 3.8.14 noch 3.8.15 haben auf
# PyPI ein cp314-Wheel oder ein Sdist (verifiziert via PyPI JSON API) - unter
# Python 3.14 schlaegt `pip install` fehl ("No matching distribution"). Der
# Dependabot-Bump auf 3.8.15 (PR #107) wurde versehentlich gemergt und hat
# main gebrochen (Docker-Build von python-nlp-service schlaegt fehl); dieser
# Pin setzt den Build wieder auf den zuletzt funktionierenden Stand zurueck.
# 3.8.13 hat sowohl cp314-Wheels als auch ein Sdist und ist damit kompatibel;
# kein CVE/Security-Advisory fuer spacy betrifft diesen Rueckschritt. Dependabot
# schlaegt Bumps auf 3.8.14/3.8.15 wiederkehrend vor - solange PyPI dafuer kein
# cp314-Wheel/Sdist hat, bleiben solche PRs abzulehnen, nicht diesen Pin lockern.
spacy==3.8.13
spacy-lookups-data==1.0.5

# HTTP Client (fuer Ollama-Calls)
requests==2.34.2

# Logging (masterbrain_common.logging nutzt pythonjsonlogger)
python-json-logger==4.2.0

# NumPy 2.x: Breaking Changes gegenueber 1.x, aber spacy 3.8.x ist kompatibel
numpy==2.5.1

# Neo4j Graph-Datenbank (fuer GraphRAG). 6.2.0 (Major-Bump von 5.27.0, bereits
# auf main gemergt): Breaking-Changes-Liste gegen den tatsaechlich genutzten
# Code geprueft (GraphDatabase.driver(), .session(), session.run(),
# .verify_connectivity()) - keine davon betroffen. Min. Python 3.10 (erfuellt,
# Image nutzt 3.14).
neo4j==6.2.0

